# =====================================================================
# Copy this file to ".env" and fill in your PayPal SANDBOX credentials.
#   PowerShell:  Copy-Item .env.example .env
# The same .env works for BOTH `npm run dev` and `docker compose up`.
# =====================================================================

# ---- PayPal (REQUIRED) ----------------------------------------------
# Get these from https://developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ---- Database name/user/password (optional) -------------------------
# Used by both Postgres (in Docker) and the payment-service.
# Defaults below match the code + docker-compose defaults; leave as-is
# unless you want different credentials.
DB_NAME=payment_db
DB_USER=payment_user
DB_PASSWORD=payment_pass

# ---------------------------------------------------------------------
# NOTE: Do NOT set DB_HOST or *_SERVICE_URL here.
#  - Local dev (`npm run dev`): services default to localhost / local ports.
#  - Docker (`docker compose up`): compose injects the internal hostnames
#    (postgres, rabbitmq, payment-service, students-service) automatically.
# ---------------------------------------------------------------------
